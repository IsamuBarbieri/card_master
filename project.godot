; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Card Master"
run/main_scene="res://scenes/menu/Splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

CardManager="*res://scripts/CardManager.gd"
AIManager="*res://scripts/AIManager.gd"
Game="*res://scripts/Game.gd"
StringTable="*res://scripts/StringTable.gd"
ControllerUI="*res://scripts/ui/ControllerUI.gd"
Net="*res://scripts/net/Net.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=544
window/stretch/mode="canvas_items"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

; Godot's default clear colour is a mid grey. It shows in two places: the
; letterbox bars on any screen that isn't 960x544 (every phone), and for the
; frame between one scene being freed and the next one drawing - which read as
; the screen flashing grey on every transition. Black is what the art already
; sits on.
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
